; Engine configuration file.
; Hand-maintained: the editor rewrites this file, so keep edits reviewable and
; keep the comments — they explain *why* the non-default settings are set.
;
; Format documented at https://docs.godotengine.org/en/stable/classes/class_projectsettings.html

config_version=5

[application]

config/name="Done Rite Detailing"
config/version="1.16.0" ; x-release-please-version
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

; The picture on the loading screen, and the two settings that put it there.
;
; These are read by more than the engine's own boot splash. Godot's web
; exporter writes this image out as `index.png` beside `index.html` and
; substitutes the filename into the shell's `$GODOT_SPLASH` — verified in
; platform/web/export/export_plugin.cpp, where `$GODOT_SPLASH` is literally
; `p_name + ".png"` and `_get_project_splash()` is what gets saved there. So
; naming the logo here is what makes it appear on the page a player waits on
; while the bundle downloads (web/shell.html), with no second copy of the
; asset for that page to point at. That is the whole reason this is set:
; assets/brand/ stays the one home of the artwork.
;
; The native boot splash gets it too, which is a consequence and a wanted one
; — it is the flash between the browser's loading screen and the title screen,
; and the alternative is Godot's own logo appearing in the middle of ours.
;
; AND IT IS WHY assets/brand/ HOLDS A .png RATHER THAN THE .jpg IT USED TO.
; The engine's boot splash loader is PNG-only — main/main.cpp's
; setup_boot_logo() rejects anything else with "The only supported format is
; PNG. Loading default splash." The web *exporter* is not so fussy and loaded
; the jpg happily, so the loading screen looked right while the native splash
; had quietly fallen back to Godot's logo. `make smoke` is what caught it: the
; message is an ERROR, and a headless boot that logs one fails the gate.
;
; So the source was converted once, by the pinned engine itself, and the jpg
; deleted rather than kept alongside — two files of the same artwork is the
; drift this whole comment exists to avoid. The cost is honest and small: 67 KB
; of jpg became 248 KB of png in the pack, against a 39 MB web bundle, and the
; export was re-encoding it to exactly this png every build anyway.
;
; bg_color is Brand.INK (#09090b) rather than the engine's default grey, so all
; three screens a player meets in the first few seconds — the download, the
; boot splash, the title card — are printed on the same black. Kept as a
; Color() literal because that is what the engine stores; the hex is in
; src/core/brand.gd, which is the source of truth for it.
boot_splash/image="res://assets/brand/done-rite-logo.png"
boot_splash/bg_color=Color(0.035294, 0.035294, 0.043137, 1)

; No autoloads on purpose. `godot --check-only` (what `make check` gates on)
; resolves global `class_name` identifiers but not autoload names, so anything
; reached through an autoload drops out of the type check. Prefer a class with
; static members — see src/core/build_info.gd.

[debug]

; Typed GDScript is the house standard (see STANDARDS.md). Level 2 = error, so
; the offending script fails to compile and CI's `make check` goes red.
; Level 1 = warning (visible, non-fatal); level 0 = ignored.
gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/return_value_discarded=0
gdscript/warnings/standalone_expression=2
gdscript/warnings/standalone_ternary=2
gdscript/warnings/incompatible_ternary=2
gdscript/warnings/narrowing_conversion=2
gdscript/warnings/int_as_enum_without_cast=2
gdscript/warnings/unused_variable=2
gdscript/warnings/unused_parameter=1
gdscript/warnings/unused_signal=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; Pick the whole window up and scale it, so the game looks the same at any
; window size instead of revealing more or less of the world.
window/stretch/mode="canvas_items"

; "expand" and not "keep", decided on a phone rather than in the abstract.
; "keep" letterboxes this 16:9 design into a portrait screen: measured in a real
; browser on an emulated Pixel 7 (411x838 CSS px), the game was a 411x231 strip
; with three quarters of the screen dead black, and a tap 25 px below the Start
; button landed in the black and did nothing. "expand" keeps the scale and the
; aspect ratio and grows the *viewport* to fill the window instead, so every
; pixel the player can see is the game's and every tap reaches it. Nothing is
; positioned absolutely — the UI is anchored and centred — so it simply lands in
; the middle of whatever it's handed.
;
; What this does NOT fix is how *small* everything gets: the scale still comes
; from the window's width against the 1280 above, so a control's size on a phone
; is roughly a third of what it says here. That is what `TouchTarget` in
; src/core/ exists to state as a number, and what the Start button is sized by.
window/stretch/aspect="expand"

; Touch input needs nothing configured here. `input_devices/pointing/
; emulate_mouse_from_touch` is on by default, which is what turns a tap into the
; click a Button understands — verified in a real browser on an emulated phone,
; where a tap on Start moves to the menu. It is not written out because the
; editor deletes any setting equal to its default (see the renderer note below),
; so the fact lives in a comment instead. Turning it off would break every
; button in the game on every touchscreen at once.

[gui]

; The face every Control in the game draws in unless it asks for the other one.
;
; This is the switch that makes issue #174 a type *system* rather than a list of
; overrides. Godot's built-in Open Sans is the default until something replaces
; it, and "something" would otherwise have to be every label, every button and
; every caption in the project — including the ones nobody has written yet. One
; missed override is a web sans sitting in the middle of a pixel-art game, and
; nothing in the build would mention it.
;
; Silkscreen and not Press Start 2P, which is the deliberate half. The default
; is what an unconsidered label gets, and the readable face is the right thing
; to hand somebody who has not thought about it: a caption that came out in the
; body face is a design opinion, where a paragraph that came out in the display
; face is a wall of letters. Brand.DISPLAY_FACE is asked for by name — see
; src/core/brand.gd for the whole argument, and tests/unit/test_brand.gd for the
; assertion that this line and that file still name the same file.
;
; It is a path and not a Theme resource because there is nothing else in the
; theme: every colour, corner and stylebox in this game already comes from
; Brand, applied in code, and a .tres holding one font would be a second place
; for the brand to live.
theme/custom_font="res://assets/brand/fonts/Silkscreen-Regular.ttf"

[input]

; The keyboard half of the tool belt. The T button in the corner is the spec and
; it is what ships; these exist because nobody playing at a desk is going to
; reach for a button in the corner of the screen to change tool.
;
; Actions and not raw keycodes in `_input`, so the binding is data the engine
; owns — remappable later without touching src/screens/play_screen.gd, and
; visible here rather than buried in a match statement.
;
; `physical_keycode` and not `keycode`: physical is the key's *position* on the
; board, so the hotbar row stays the hotbar row on a layout that prints
; different letters on it. This is the standard choice for game bindings and the
; wrong one for text entry, which is not what these are.
;
; Escape is `tool_belt_close` and deliberately NOT the built-in `ui_cancel`.
; Whatever ends up owning pause will want Escape too, and it must not fire on
; the same press that put the roll-up away — so this is a separate action that
; play_screen.gd consumes only while the roll-up is actually open.

