[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/ui/grime_debug.gd" id="1_grimedebug"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_grimebg"]
bg_color = Color(0, 0, 0, 0.62)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

; Bottom-left: the one corner of a 1280x720 frame that nothing else claims — the
; readout is top-left, the roll-up's T is beside it and the motion pad owns the
; right-hand edge. Anchored rather than positioned so it stays in the corner when
; "expand" grows the viewport on a phone.
;
; `mouse_filter = 2` (ignore) on this and on everything under it, because this is
; a picture and not a control: a press that lands on it has to reach the glass
; behind it, or the water would stop wherever the masks were drawn.
[node name="GrimeDebug" type="PanelContainer"]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = -12.0
offset_bottom = -12.0
grow_vertical = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_grimebg")
script = ExtResource("1_grimedebug")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="Stack" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2

[node name="Title" type="Label" parent="Margin/Stack"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.55, 1)
theme_override_font_sizes/font_size = 14
text = "GRIME MASKS"

[node name="Masks" type="GridContainer" parent="Margin/Stack"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 4
columns = 4
