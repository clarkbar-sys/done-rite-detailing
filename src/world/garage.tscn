; The trees, rolled from fixed seeds at _ready() and stood along the outer edge
; of the two strips of grass above — src/world/grove.gd has the argument for
; all of it, including why the middle of each edge is left empty (the camera
; orbits through there) and why nothing out here has a collider.
;
; Its defaults are the driveway's numbers, so there is nothing to override: the
; rows stand at x = ±5.9 on grass that runs to ±6.2, stop at z = ±6.4 on grass
; that runs to ±6.7, and keep 7.2 m clear of the middle, which is the Camera's
; own orbit plus a crown plus a margin. tests/integration/test_grove.gd does all
; three sums against the grass and the camera rather than repeating them.
[node name="Grove" parent="View/World/Ground" instance=ExtResource("6_grove")]

[node name="Car" parent="View/World" instance=ExtResource("3_car")]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.7, 0)

; keep_aspect 0 is KEEP_WIDTH, so the 75 below is the angle measured *across* the
; frame and the angle up and down falls out of the viewport's shape. That is the
; whole reason this node carries a script: at 16:9 it works out at 46.7° down, and
; on a phone held upright — where `window/stretch/aspect = "expand"` grows the
; viewport downward instead of letterboxing — the same 75 works out at 114.8°.
; `Lens` holds a ceiling over that second number by giving up the first. 75 stays
; the lens the shot was framed at, and is what a wide screen still gets.
[node name="Camera" type="Camera3D" parent="View/World"]
unique_name_in_owner = true
script = ExtResource("5_lens")
keep_aspect = 0
current = true
fov = 75.0

[node name="ViewModel" type="Node3D" parent="View/World/Camera"]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.17, -0.15, -0.45)
visible = false
script = ExtResource("2_view_model")
