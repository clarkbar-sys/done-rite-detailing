[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://src/screens/play_screen.gd" id="1_play"]
[ext_resource type="PackedScene" path="res://src/world/garage.tscn" id="2_garage"]
[ext_resource type="PackedScene" path="res://src/ui/tool_belt_hud.tscn" id="3_hud"]
[ext_resource type="PackedScene" path="res://src/ui/grime_debug.tscn" id="5_grimedebug"]
[ext_resource type="PackedScene" path="res://src/ui/score_hud.tscn" id="6_score"]
[ext_resource type="Script" path="res://src/ui/sound_toggle.gd" id="7_sound"]
[ext_resource type="Script" path="res://src/ui/time_hud.gd" id="8_time"]

[node name="PlayScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_play")

[node name="Garage" parent="." instance=ExtResource("2_garage")]
orbiting = false
first_person = true
walkaround = true
noisy = true

; The one corner none of this screen's own HUD reaches: the belt owns
; bottom-left, and the score shares top-right with the grime board's toggle —
; see src/ui/sound_toggle.gd. Bottom-right belonged to the motion pad until
; the walk became a gesture on the glass itself (#179); it is the picture of
; the garage again.
[node name="Sound" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 0
script = ExtResource("7_sound")

[node name="ToolBelt" parent="." instance=ExtResource("3_hud")]
layout_mode = 1

; Which panel the mark is on, in the one corner of the screen neither the
; belt nor the pad reaches. Debug scaffolding — see `_on_aimed` in
; play_screen.gd — so it is a plain Label with a font big enough to read at the
; third-scale a phone renders this design at, and an outline because the thing
; behind it is sometimes sky and sometimes tarmac.
;
; 24 rather than the 32 it was, and it is not a taste change: the display face
; play_screen.gd puts on this label advances a whole em per character
; (Brand.DISPLAY_FACE), so a panel name costs twice the width it used to. The
; box below is 348 px, which is fourteen characters at 24 and ten at 32, and the
; longest name the room has is nine.
; Shifted clear of the grime board's toggle, which now sits in this corner at a
; full tap target's width. It used to start at x=12 and the two would overlap.
[node name="PanelReadout" type="Label" parent="."]
layout_mode = 1
offset_left = 188.0
offset_top = 12.0
offset_right = 536.0
offset_bottom = 56.0
theme_override_colors/font_color = Color(0.95, 0.13, 0.16, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.7)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 24

; The clock, along the top and centred — see src/ui/time_hud.gd, which owns
; everything about how it looks and leaves only where it sits to this file.
;
; Top-centre because it is the one part of the top edge nothing else wants. The
; panel readout runs from x=188 to x=536, and the score column is a third of the
; screen in from the right margin (score_hud.gd's `_row_width`), which on the
; 1280 design starts at x=853. This sits in the 317 px between them, 400 wide and
; centred, so it stays clear of both at any screen shape rather than at this one.
;
; Anchored to the top edge and grown from the middle (anchors_preset 5) rather
; than placed at a design-pixel offset: window/stretch/aspect is "expand", so a
; portrait phone gets the design width and a great deal more height, and anything
; measured from the top-left of a fixed rectangle would drift.
[node name="TimeHud" type="Label" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 0)
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -200.0
offset_top = 12.0
offset_right = 200.0
offset_bottom = 118.0
grow_horizontal = 2
text = "3:00"
script = ExtResource("8_time")

; The score, in the top-right corner. Before the grime board in the tree so the
; board's toggle and its thumbnails draw over it rather than under — the two
; share that corner in debug builds, and score_hud.gd's `_top` drops the digits
; clear of the toggle rather than relying on this ordering to hide the overlap.
[node name="ScoreHud" parent="." instance=ExtResource("6_score")]
layout_mode = 1

; Every panel's grime mask, drawn flat. Hidden until the key is pressed — see
; `GRIME_DEBUG_ACTION` in play_screen.gd — and last in the tree so it draws over
; the room rather than under it.
[node name="GrimeDebug" parent="." instance=ExtResource("5_grimedebug")]
layout_mode = 1
