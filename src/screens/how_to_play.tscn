[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/screens/how_to_play.gd" id="1_howtoplay"]
[ext_resource type="PackedScene" path="res://src/world/garage.tscn" id="2_garage"]

[node name="HowToPlay" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_howtoplay")

; The same room every other screen shows, on the same four switches. Mostly
; covered by the card in front of it — see how_to_play.gd for what that costs
; and what it buys.
[node name="Garage" parent="." instance=ExtResource("2_garage")]
orbiting = false
first_person = true
walkaround = true
attracting = true

; At least 16 px of room left showing on every side, so the card reads as a
; sheet held up in the bay rather than a new screen that replaced it.
[node name="Frame" type="MarginContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

; What stops the sheet stretching to whatever shape the screen is.
;
; The design is 1280x720 and project.godot stretches it "expand", which means a
; portrait phone does not get a letterboxed 16:9 strip — it gets the design
; width and as many extra design pixels of *height* as its aspect asks for. An
; emulated 1080x2340 handset resolves to 1280x2773, nearly four times the height
; this screen was laid out against. A card anchored to that is a card with two
; thousand pixels of nothing in the middle of it, which is exactly what shipped
; and what this row exists to prevent.
;
; The card takes its own height and this row centres what is left over, so the
; extra goes to the room above and below the sheet rather than inside it. On a
; 16:9 screen there is nothing to give away and the layout is the one the mockup
; shows.
;
; It takes both properties, and that is worth writing down because only one of
; them looks like it should be enough: `alignment` is what centres a child along
; a BoxContainer's own axis, and the card's `size_flags_vertical = 4`
; (SHRINK_CENTER) is what stops it filling in the first place. Set on its own,
; the size flag centres the card horizontally — the cross axis — and leaves it
; pinned to the top of the screen, which is how this was first written and what
; the render showed.
[node name="Sheet" type="VBoxContainer" parent="Frame"]
layout_mode = 2
alignment = 1

[node name="Card" type="PanelContainer" parent="Frame/Sheet"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4

[node name="Column" type="VBoxContainer" parent="Frame/Sheet/Card"]
layout_mode = 2
theme_override_constants/separation = 12

; A flow row and not an HBoxContainer, because the type on this screen is not a
; fixed size — how_to_play.gd grows it to use the height a tall screen hands
; over. At the sizes a portrait phone gets, "HOW TO PLAY" plus the caption is
; wider than the sheet, and an HBoxContainer answers that by squashing its
; children past their own minimums. A flow row wraps the caption onto its own
; line instead, which is what it should do anyway.
[node name="Header" type="HFlowContainer" parent="Frame/Sheet/Card/Column"]
layout_mode = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 2

[node name="Title" type="Label" parent="Frame/Sheet/Card/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "HOW TO"

[node name="TitleAccent" type="Label" parent="Frame/Sheet/Card/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "PLAY"

; Baseline-ish rather than top-aligned: a 16 px caption hung off the top of a
; 32 px heading reads as a mistake.
[node name="Subtitle" type="Label" parent="Frame/Sheet/Card/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 6
theme_override_font_sizes/font_size = 16
text = "three passes, in this order"

[node name="Rule" type="ColorRect" parent="Frame/Sheet/Card/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 3)
layout_mode = 2

; The whole of the rules, and there used to be seven hundred characters of them.
; #175 has the argument; what is left is the one thing a new player has to know
; that the bay does not teach by itself — that a panel goes water, then bottle,
; then rag, and that a step out of order does nothing. Three numbers and six
; words, which is short enough to read by accident, and the button under it is
; for anybody who wants the rest.
;
; Numbered rather than arrowed. The order is the entire content of this strip,
; and a row that reflows onto two lines on a narrow phone — which this one is
; free to do, the captions wrap — would have its arrows pointing at the wrong
; neighbours the moment it did. A "1." reads the same wherever it lands.
[node name="Strip" type="HBoxContainer" parent="Frame/Sheet/Card/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 16

[node name="Water" type="VBoxContainer" parent="Frame/Sheet/Card/Column/Strip"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Heading" type="Label" parent="Frame/Sheet/Card/Column/Strip/Water"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "1. SPRAY"

[node name="Body" type="Label" parent="Frame/Sheet/Card/Column/Strip/Water"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "mud off"
autowrap_mode = 3

[node name="Bottle" type="VBoxContainer" parent="Frame/Sheet/Card/Column/Strip"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Heading" type="Label" parent="Frame/Sheet/Card/Column/Strip/Bottle"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "2. SPONGE"

[node name="Body" type="Label" parent="Frame/Sheet/Card/Column/Strip/Bottle"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "product on"
autowrap_mode = 3

[node name="Rag" type="VBoxContainer" parent="Frame/Sheet/Card/Column/Strip"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Heading" type="Label" parent="Frame/Sheet/Card/Column/Strip/Rag"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "3. BUFF"

[node name="Body" type="Label" parent="Frame/Sheet/Card/Column/Strip/Rag"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "shine up"
autowrap_mode = 3

; The film, on a row of its own between the passes and the way out.
;
; Not on the bottom row with the two exits, and that is the placement decision
; worth writing down: the bottom row is "leave this screen", it has been two
; buttons at opposite ends since this screen shipped, and a third pill in the
; middle of it would make the accent one of three rather than one of two. This
; is the other half of what the screen is *for*, so it sits with the passes it
; illustrates.
;
; Alone on its row, which is also what lets it be wide: how_to_play.gd caps a
; pill at its share of the row it is on (see _widest_button), and this one's
; share is all of it. Centred rather than stretched — a pill the width of the
; card reads as a banner rather than a button.
;
; 10 px of margin either side for the ButtonRow's reason: a pill carries a 30 px
; glow and a button flush with the card's inner edge throws red past its border.
[node name="WatchRow" type="MarginContainer" parent="Frame/Sheet/Card/Column"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_right = 10

[node name="Watch" type="Button" parent="Frame/Sheet/Card/Column/WatchRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(480, 164)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 24
text = "Watch how it's done"

; Left and right only, and deliberately not top or bottom: a pill carries a
; 30 px glow (Brand.PILL_SHADOW_SIZE), so a button flush with the card's inner
; edge throws red past the card's border. Ten pixels is enough to keep the glow
; on the sheet, and taking it horizontally costs the column no height it needs.
[node name="ButtonRow" type="MarginContainer" parent="Frame/Sheet/Card/Column"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_right = 10

; Both exits on one row, at opposite ends, so the screen can be left either way
; round without either button being the one you find by accident.
;
; Guillemets and not the mockup's ◀ / ▶. Written when the project shipped no
; font of its own and every label was drawn in Godot's built-in Open Sans, which
; has no geometric shapes block — U+25C0 and U+25B6 came out as tofu boxes,
; which is what shipped and what test_the_font_can_draw_every_word pins. U+00AB
; and U+00BB are Latin-1, present in anything, and point the same way.
;
; They stay after #174 gave the game its own two faces, and not out of inertia:
; Brand.DISPLAY_FACE (what a Button wears) does have the triangles, but
; Brand.BODY_FACE does not, and a pair of marks that reads correctly in only one
; of the project's two faces is a pair of marks waiting to be moved onto a label.
; The guillemets are in both. src/ui/car_arrow.gd reaches the same conclusion
; about the same expired reason.
;
; All three buttons on this screen are held at 164 design px in their short
; dimension — TouchTarget.min_design_size() for this design on a 375 px screen —
; which is what stops the layout borrowing height from them when something above
; wants more.
;
; The two type sizes are 24 and 32 where they were 36 and 44, and the drop is
; arithmetic rather than taste: the display face advances a whole em per
; character, so "«  Main Menu" is 12 x size wide and nothing else. 24 puts it at
; 288 px inside a 340 px pill; 32 would put it at 384 and grow the button past
; the width the row was laid out for. Play is the larger of the two for the same
; reason it is the red one. The watch button above takes the smaller of the two
; sizes for the same arithmetic — it says nineteen characters, which is 456 px
; at 24 and would be 608 at 32.
[node name="Buttons" type="HBoxContainer" parent="Frame/Sheet/Card/Column/ButtonRow"]
unique_name_in_owner = true
layout_mode = 2

[node name="MainMenu" type="Button" parent="Frame/Sheet/Card/Column/ButtonRow/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(340, 164)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "«  Main Menu"

[node name="Spacer" type="Control" parent="Frame/Sheet/Card/Column/ButtonRow/Buttons"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Play" type="Button" parent="Frame/Sheet/Card/Column/ButtonRow/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 164)
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Play  »"
