[ext_resource type="PackedScene" path="res://src/world/garage.tscn" id="2_garage"]
[ext_resource type="Texture2D" path="res://assets/brand/done-rite-logo.png" id="3_logo"]
[ext_resource type="Script" path="res://src/ui/sound_toggle.gd" id="4_sound"]
[ext_resource type="Script" path="res://src/ui/car_arrow.gd" id="5_arrow"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

; The same four switches the title card sets, so the bay behind the menu is the
; bay behind the title — one Garage instance, playing itself, and the player
; walks into the room it has been showing them.
[node name="Garage" parent="." instance=ExtResource("2_garage")]
orbiting = false
first_person = true
walkaround = true
attracting = true

; The same corner control the title card carries — see
; src/ui/sound_toggle.gd — so the choice a player made there is still visible,
; and still pressable, one screen later.
[node name="Sound" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 0
script = ExtResource("4_sound")

; The two ways through the pack, one against each edge of the screen and
; vertically centred — see src/ui/car_arrow.gd for why the chevron is drawn
; rather than typed, and src/screens/main_menu.gd for what a press does.
;
; Out here rather than in the column under the logo, and that is arithmetic
; rather than taste. A row of arrows is a row a finger has to hit, so it is at
; least TouchTarget.min_design_size() (164) tall; the column already runs 645 of
; the design's 720 and the credit line owns the last 48 of those. There is no
; height to give it. The edges, meanwhile, are the emptiest part of this screen
; and are where a thumb already is on a phone held in two hands.
;
; 176 square: the height Play wears, comfortably over the 164 floor, and square
; because dress_quiet cuts the pill round at the button's own height and a round
; plate is what an icon rather than a caption goes on — the same shape and the
; same reasoning as the sound toggle's corner. 12 in from the edge is
; ToolBeltHud.MARGIN, which is what every other thing in this game pinned to a
; screen edge stands off by.
[node name="PreviousCar" type="Button" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(176, 176)
layout_mode = 1
anchors_preset = 4
anchor_top = 0.5
anchor_bottom = 0.5
offset_left = 12.0
offset_top = -88.0
offset_right = 188.0
offset_bottom = 88.0
grow_vertical = 2
script = ExtResource("5_arrow")
backwards = true

[node name="NextCar" type="Button" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(176, 176)
layout_mode = 1
anchors_preset = 6
anchor_left = 1.0
anchor_top = 0.5
anchor_right = 1.0
anchor_bottom = 0.5
offset_left = -188.0
offset_top = -88.0
offset_right = -12.0
offset_bottom = 88.0
grow_horizontal = 0
grow_vertical = 2
script = ExtResource("5_arrow")

; `mouse_filter = 2` (ignore) rather than the engine's default `stop`: this is
; full-rect, so left at the default it would claim every point on the screen
; for itself — including the sound toggle's corner, where none of its own
; children are actually drawn — before a sibling earlier in the tree ever saw
; the press. Play and How to Play are unaffected either way: a child control's
; own filter, not its container's, decides whether it reacts to a point over it.
;
; `offset_bottom` is half the ground the menu gave when the fifth borrowed model
; arrived (#154); the other half came off the lockup below. The column centres in
; what is left rather than in the whole screen, and centring is why 44 buys 22: a
; column given 44 px less room moves its bottom edge up by half of it. The two
; halves together take the pills up 44 px, and 23 of that is what the credit's
; third line costs at the size 16 px type sets on. The remaining 21 is spent on
; something two lines only just had: the credit cleared the last row of ink in
; "How to Play" by 37 px rather than by 16 — 78 px since #174 took the credit's
; type down to 12 and the pill's to 32, and 94 px since #162 took the fifth work
; off the list again. It is tests/integration/test_main_menu.gd that measures the
; clearance off the font rather than off these offsets, which is why neither a
; change of face nor a credit going away needed a change of number here — and why
; the 44 px this line is about has not been handed back, which is the same
; argument the credit's own comment makes below.
[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_bottom = -44.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Column" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="LogoCard" type="PanelContainer" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4

; 220x185 against the title card's 380x319: the lockup gives up height three
; times over — once so the second pill fits under it, again so the car's name
; does, and now so a third line of credit fits along the bottom — and every time
; so the column does not run off a 720-tall screen into the credit line. 185 is 44
; less than the 229 it was, and it is the second of the two halves the fifth
; credited work cost: 44 here and 44 off the Center container above, which between
; them take the How to Play pill up 44 px. The width follows the height rather than
; being tuned on its own — 220 is 185 at the artwork's own 1.19, so the lockup is
; smaller and not squashed. Same picture, same card, same mipmapped filter — see
; src/screens/title_screen.gd for why the filter is not this project's default.
[node name="Logo" type="TextureRect" parent="Center/Column/LogoCard"]
unique_name_in_owner = true
texture_filter = 4
custom_minimum_size = Vector2(220, 185)
layout_mode = 2
texture = ExtResource("3_logo")
expand_mode = 1
stretch_mode = 5

; Which of the ten is parked behind this screen, and the only thing on it that
; says so — the arrows either side are a picture and the bay itself is the
; answer. Where the 20 px spacer used to be, doing its job as well as its own:
; the column still needs air between the lockup and the first pill, and a line of
; type in that air reads as a caption for the room rather than as a label
; somebody had to find room for.
;
; The text here is a placeholder. main_menu.gd sets it from CarChoice.label_for
; in `_ready`, before the first frame, exactly as it sets the build stamp — what
; is in the file is what a scene-file reader should see rather than an empty
; string.
[node name="CarName" type="Label" parent="Center/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Sedan"
horizontal_alignment = 1
vertical_alignment = 1

; The size Start wears on the title card, unchanged: this is the same press,
; one screen later.
[node name="Play" type="Button" parent="Center/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(440, 176)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 64
text = "Play"

; Smaller than Play, and only just: 168 is a few pixels above
; TouchTarget.min_design_size() (164 for this design on a 375 px screen), which
; is the floor a button stops shrinking at whatever the layout would prefer.
; "Secondary" is therefore said in type size and in colour — 32 against 64, and
; Brand.quiet_pill against Brand.RED — rather than in a height nobody on a phone
; could hit.
;
; 32 and not the 44 it was, and the gap widened for a reason that is arithmetic
; rather than emphasis. Brand.DISPLAY_FACE advances a whole em per character, so
; a caption is exactly `length x size` px wide: "How to Play" is eleven
; characters, which is 352 px at 32 and 484 at 44 — wider than the 440 px pill it
; is printed on, and a Button grows to fit its own text rather than clipping it.
; So the second pill would have come out wider than the first. Play is four
; characters and 256 px at 64, which is why the loud one kept its size while the
; quiet one gave up twelve.
[node name="HowToPlay" type="Button" parent="Center/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(440, 168)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 32
text = "How to Play"

; The credits for the borrowed models, along the bottom of the menu.
;
; CC-BY 4.0 is the licence the ten models in assets/models/cars/ arrive under —
; and the licence the tyre cleaner's bottle, the sponge and the driveway all four
; of them are used on arrive under too — and attribution is a condition of it, not
; a courtesy. So it has to be somewhere a player can actually read, and this is
; the screen every player passes through on the way to the bay. The same lines are
; in README.md and in the ATTRIBUTION.txt files beside the assets — five of those,
; because the wand keeps one saying that nothing about it is borrowed; this is the
; copy the licence is actually satisfied by,
; because the others ship to whoever clones the repo rather than to whoever plays
; the game.
;
; Every work names what it is used for, its title, its author and a link, and all
; but the first link the author's page rather than the model's: the car pack has
; a skfb.ly short link and the others do not, and their full URLs are 60-odd
; characters of hex that would wrap the line on a phone. The direct link to each
; model is in the ATTRIBUTION.txt beside it and in README.md.
;
; AND THE LAST LINE SAYS WHICH OF THEM WERE CHANGED (#159), BECAUSE THE LICENCE
; ASKS FOR THAT TOO. CC-BY 4.0 3(a)(1)(B) wants an indication that the material
; was modified, on the same footing as the title and the author — and three of
; these four are modified rather than placed: the cars are baked into ten
; per-style .glb files by scripts/build-car-pack.py with the body greyscaled so
; the game can tint it, the bottles are one sprayer processed and then recoloured
; by scripts/build-tire-cleaner.py and scripts/build-window-cleaner.py, and the
; sponge is flattened and its maps cut down by scripts/build-sponge.py. The
; driveway is the artist's file as downloaded, which is why it is named as the
; one that is not. README.md has said all of this since the bakes existed; this
; line is what puts it in front of the player, which is where the licence asks
; for it.
;
; ONE LINE FOR ALL FOUR RATHER THAN A WORD ON EACH, AND THAT IS THE WIDTH AGAIN.
; ", modified" twice on the first line measures 1,316 px in a 1,248 px label —
; wider than the box, so it wraps, and the thing it wraps over is the pill. The
; sentence on its own is 621 px and fits with room to spare. Vertically it is the
; third line #174's arithmetic already priced and #162 handed back: 12 px
; Silkscreen sets on 16, so the block is 48 px against the 68 the offsets below
; give it, sitting in y = 660 .. 708 and clearing the last row of ink in "How to
; Play" (y = 550 .. 582) by 78 px where two lines cleared it by 94. Measured, not
; assumed, and tests/integration/test_main_menu.gd measures it again off the font
; rather than off these offsets. Nothing else on the screen moves.
;
; TWO WORKS PER LINE SINCE THE SPONGE (#155), AND THE COUNT IS THE REASON.
; The line this replaced said a fourth work would have to be paid for by the menu
; giving ground rather than by the type getting smaller again. Measured at the
; 1280x720 design size, the menu has no ground to give: the column runs from
; y = 21 to y = 699, both pills are already at the floor
; TouchTarget.min_design_size() puts them at, and the How to Play label sits in
; y = 584.5 .. 645.5. That leaves 62 px between the label and the 12 px margin at
; the bottom of the frame — 4 lines would have to be 15 px apart to fit in it,
; where 16 px type sets on 23, and even 3 lines at 23 overhang it by 6. So the
; credit went from four lines to two, one pair of works each, and the whole block
; was 46 px sitting in y = 662 .. 708: clear of the button's label by 16 px, and
; with room for a fifth work before any of this has to be thought about again.
;
; AND A THIRD LINE SINCE THE PRESSURE WASHER (#154), WHICH THE MENU GAVE GROUND
; FOR. The fifth work is the one that paragraph said there was room for, and there
; was — room on the list, not room on the line: a work sets 400-600 px wide and
; neither line had that spare in the 1,248 px the label is given. So five works
; are 2 + 2 + 1, and the block is 69 px in y = 639 .. 708 rather than 46. 639 is
; the third line the count above measured as overhanging the pill by 6 px, so this
; time the ground came off the menu rather than off the type: 44 px off the lockup
; and 44 off the Center container, each worth half of itself to a centred column,
; which takes both pills up 44 px. That puts the last row of ink in "How to Play"
; at y = 601.5, so the credit clears it by 37 px where two lines cleared it by 16.
; The type was still 16 and the credit still sat on the bottom margin.
;
; AND THE FACE CHANGED UNDER ALL OF IT (#174), WHICH IS WHY THE SIZE SAYS 12.
; Everything above is arithmetic against Godot's built-in Open Sans, which is no
; longer what this label is drawn in: the project now ships its own type and the
; default face is Brand.BODY_FACE (Silkscreen), a pixel face that advances about
; three quarters of an em where a web sans averages half. Same words, one and a
; half times the width — at 16 the longest line measured 1,548 px in a 1,248 px
; label and would have wrapped to a fourth and fifth line straight across the
; pill.
;
; 12 is the largest size that still fits, and it is a hard edge rather than a
; preference: the three lines are 1,168, 1,152 and 743 px at 12, and the longest
; goes to 1,260 at 13 — 12 px over the label. That is also why this one number is
; not a multiple of Brand.TYPE_GRID when every other size in the project is. The
; grid's next step down is 8, which is small print nobody can read at a third
; scale, and its next step up is 16, which does not fit. A licence line is a
; fixed number of characters in a fixed width, and it is the one place in the
; game where the copy cannot give and the box cannot either.
;
; What the smaller type buys back is room. Silkscreen sets 12 px type on 16
; rather than the 23 the old face needed, so the block is 48 px in y = 660 .. 708
; where it was 69 in y = 639 .. 708 — and the last row of ink in "How to Play"
; (now at y = 550 .. 582, the pill's own type having come down from 44 to 32)
; is cleared by 78 px where three lines used to clear it by 37. The ground #154
; took off the lockup and off the Center container has not been given back,
; because the menu is not crowded now and un-picking that would move both pills
; for no reason a player could see.
;
; AND BACK TO TWO LINES (#162), BECAUSE THE FIFTH WORK STOPPED BEING BORROWED.
; The power wash was drawn from a downloaded flamethrower and is now drawn by
; scripts/build-pressure-washer.py, so there is no licence to satisfy for it and
; its line comes off. Four works, 2 + 2, and the driveway joins the sponge on the
; second line rather than the list keeping a line to itself: measured, that line
; is 1,185 px against the 1,168 of the first, so the pair fit the label with 63 px
; to spare and neither wraps. The block is 32 px in y = 676 .. 708 and clears the
; pill's last row of ink by 94 px.
;
; The type stays at 12 rather than going back up. 16 does not fit — see the
; paragraph above, where that is measured rather than assumed — and it is the
; longest line that decides, which is still the one about the cars and the
; bottles and is unchanged by any of this.
;
; None of the lines wraps on any screen shape: the design width is a floor
; rather than a target (window/stretch/aspect is "expand"), so 1,248 px is the
; least this label is ever given.
;
; vertical_alignment 2 is what makes those numbers true of the text rather than
; of the box: the label's own height only grows past the offsets below once the
; text needs more than they give, so a bottom-aligned block sits on the bottom
; margin at two lines and at four, and never drifts up towards the button as
; works are removed.
;
; A credit laid out off the bottom of the picture, or across the button, is not a
; credit — tests/integration/test_main_menu.gd measures both rather than trusting
; the offsets here.
;
; Bottom-left and quiet on purpose. It is not a design element and it is not a
; secret: the licence asks for the title, the author and the licence, "reasonable
; to the medium", and a line of small type along the foot of the menu is what
; that looks like on a screen whose whole job is two buttons. main_menu.gd gives
; it Brand.MUTED over an ink outline, the same treatment the score wears, because
; the thing behind it is a lit driveway and grey on white is the one way muted
; type fails.
;
; anchors_preset 12 is bottom-wide: pinned to the bottom edge and stretched
; across, so the line sits on the floor of any screen shape rather than at a
; design-pixel offset a portrait phone would put in the middle of nowhere.
[node name="Credits" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -80.0
offset_right = -16.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 0
theme_override_font_sizes/font_size = 12
text = "Cars: “Generic passenger car pack” by Comrade1280 (skfb.ly/6sUFy) · Bottles: “Kitchen Spray” by Jesus Osco (sketchfab.com/gsus.vfx) — CC BY 4.0\nSponge: “Sponge” by Aullwen (sketchfab.com/Aullwen) · Driveway: “Sunken Driveway Parking Spot” by jimbogies (sketchfab.com/jimbogies) — CC BY 4.0\nCars, bottles and sponge are modified from the originals; the driveway is not."
vertical_alignment = 2
autowrap_mode = 3

