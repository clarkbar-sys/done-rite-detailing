[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://src/screens/main_menu.gd" id="1_menu"]
[ext_resource type="PackedScene" path="res://src/world/garage.tscn" id="2_garage"]
[ext_resource type="Texture2D" path="res://assets/brand/done-rite-logo.png" id="3_logo"]
[ext_resource type="Script" path="res://src/ui/sound_toggle.gd" id="4_sound"]
[ext_resource type="Script" path="res://src/ui/car_arrow.gd" id="5_arrow"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

; The same four switches the title card sets, so the bay behind the menu is the
; bay behind the title — one Garage instance, playing itself, and the player
; walks into the room it has been showing them.
[node name="Garage" parent="." instance=ExtResource("2_garage")]
orbiting = false
first_person = true
walkaround = true
attracting = true

; The same corner control the title card carries — see
; src/ui/sound_toggle.gd — so the choice a player made there is still visible,
; and still pressable, one screen later.
[node name="Sound" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 0
script = ExtResource("4_sound")

; The two ways through the pack, one against each edge of the screen and
; vertically centred — see src/ui/car_arrow.gd for why the chevron is drawn
; rather than typed, and src/screens/main_menu.gd for what a press does.
;
; Out here rather than in the column under the logo, and that is arithmetic
; rather than taste. A row of arrows is a row a finger has to hit, so it is at
; least TouchTarget.min_design_size() (164) tall; the column already runs 645 of
; the design's 720 and the credit line owns the last 48 of those. There is no
; height to give it. The edges, meanwhile, are the emptiest part of this screen
; and are where a thumb already is on a phone held in two hands.
;
; 176 square: the height Play wears, comfortably over the 164 floor, and square
; because dress_quiet cuts the pill round at the button's own height and a round
; plate is what an icon rather than a caption goes on — the same shape and the
; same reasoning as the sound toggle's corner. 12 in from the edge is
; ToolBeltHud.MARGIN, which is what every other thing in this game pinned to a
; screen edge stands off by.
[node name="PreviousCar" type="Button" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(176, 176)
layout_mode = 1
anchors_preset = 4
anchor_top = 0.5
anchor_bottom = 0.5
offset_left = 12.0
offset_top = -88.0
offset_right = 188.0
offset_bottom = 88.0
grow_vertical = 2
script = ExtResource("5_arrow")
backwards = true

[node name="NextCar" type="Button" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(176, 176)
layout_mode = 1
anchors_preset = 6
anchor_left = 1.0
anchor_top = 0.5
anchor_right = 1.0
anchor_bottom = 0.5
offset_left = -188.0
offset_top = -88.0
offset_right = -12.0
offset_bottom = 88.0
grow_horizontal = 0
grow_vertical = 2
script = ExtResource("5_arrow")

; `mouse_filter = 2` (ignore) rather than the engine's default `stop`: this is
; full-rect, so left at the default it would claim every point on the screen
; for itself — including the sound toggle's corner, where none of its own
; children are actually drawn — before a sibling earlier in the tree ever saw
; the press. Play and How to Play are unaffected either way: a child control's
; own filter, not its container's, decides whether it reacts to a point over it.
;
; `offset_bottom` is half the ground the menu gave when the fourth borrowed model
; arrived (#154); the other half came off the lockup below. The column centres in
; what is left rather than in the whole screen, and centring is why 44 buys 22: a
; column given 44 px less room moves its bottom edge up by half of it. The two
; halves together take the pills up 44 px, and 26 of that is what the fourth line
; of credit costs — a 23 px line plus the 3 px `line_spacing` above it. The
; remaining 18 is spent on something the three-line credit never had: its top line
; now starts below the last row of ink in "How to Play" rather than a few pixels
; into it, which tests/integration/test_main_menu.gd measures off the font.
[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_bottom = -44.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Column" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="LogoCard" type="PanelContainer" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4

; 220x185 against the title card's 380x319: the lockup gives up height three
; times over — once so the second pill fits under it, again so the car's name
; does, and now so a fourth line of credit fits along the bottom — and every time
; so the column does not run off a 720-tall screen into the credit line. 185 is 44
; less than the 229 it was, and it is the second of the two halves the fourth
; credit cost: 44 here and 44 off the Center container above, which between them
; take the How to Play pill up 44 px. The width follows the height rather than
; being tuned on its own — 220 is 185 at the artwork's own 1.19, so the lockup is
; smaller and not squashed. Same picture, same card, same mipmapped filter — see
; src/screens/title_screen.gd for why the filter is not this project's default.
[node name="Logo" type="TextureRect" parent="Center/Column/LogoCard"]
unique_name_in_owner = true
texture_filter = 4
custom_minimum_size = Vector2(220, 185)
layout_mode = 2
texture = ExtResource("3_logo")
expand_mode = 1
stretch_mode = 5

; Which of the ten is parked behind this screen, and the only thing on it that
; says so — the arrows either side are a picture and the bay itself is the
; answer. Where the 20 px spacer used to be, doing its job as well as its own:
; the column still needs air between the lockup and the first pill, and a line of
; type in that air reads as a caption for the room rather than as a label
; somebody had to find room for.
;
; The text here is a placeholder. main_menu.gd sets it from CarChoice.label_for
; in `_ready`, before the first frame, exactly as it sets the build stamp — what
; is in the file is what a scene-file reader should see rather than an empty
; string.
[node name="CarName" type="Label" parent="Center/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Sedan"
horizontal_alignment = 1
vertical_alignment = 1

; The size Start wears on the title card, unchanged: this is the same press,
; one screen later.
[node name="Play" type="Button" parent="Center/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(440, 176)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 64
text = "Play"

; Smaller than Play, and only just: 168 is a few pixels above
; TouchTarget.min_design_size() (164 for this design on a 375 px screen), which
; is the floor a button stops shrinking at whatever the layout would prefer.
; "Secondary" is therefore said in type size and in colour — 44 against 64, and
; Brand.quiet_pill against Brand.RED — rather than in a height nobody on a phone
; could hit.
[node name="HowToPlay" type="Button" parent="Center/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(440, 168)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 44
text = "How to Play"

; The credits for the borrowed models, along the bottom of the menu.
;
; CC-BY 4.0 is the licence the ten models in assets/models/cars/ arrive under —
; and the licence the tyre cleaner's bottle, the pressure washer and the driveway
; all four of them are used on arrive under too — and attribution is a condition
; of it, not a courtesy. So it has to be somewhere a player can actually read, and
; this is the screen every player passes through on the way to the bay. The same
; lines are in README.md and in the four ATTRIBUTION.txt files beside the assets;
; this is the copy the licence is actually satisfied by, because the others ship
; to whoever clones the repo rather than to whoever plays the game.
;
; One line per work, and all but the first link the author's page rather than the
; model's: the car pack has a skfb.ly short link and the other three do not, and
; their full URLs are 60-odd characters of hex that would wrap the line on a
; phone. The direct link to each model is in the ATTRIBUTION.txt beside it and in
; README.md.
;
; The third line arrived with the driveway (#114), and it is what took the type
; from 20 down to 16. Three lines at 20 is 84 design px of credit standing under
; a menu that leaves 90 between the How to Play pill's own words and the bottom
; of the frame — the first line landed across the button's label. Sixteen fits
; the three of them into 75 and clears it. The credit is small type along the
; foot of the menu by design and this is a little smaller again, which is the
; cost of a third borrowed model; a fourth would need the menu to give ground
; rather than the type.
;
; The fourth line arrived with the pressure washer (#154), and the menu gave the
; ground rather than the type, exactly as that sentence says it would. Four lines
; at 16 is 101 px where three were 75, and the menu found the 26 by moving the
; pills 44 px up — 44 off the lockup and 44 off the Center container, each worth
; half of itself to a centred column. The type is still 16, and the 18 px of
; change bought the credit something it did not have at three lines: its top line
; now starts below the last row of ink in "How to Play" instead of a few pixels
; into it. There is no fifth line's worth of slack up there: a fifth borrowed
; model wants the same two edits again, and it is worth asking at that point
; whether the works should be laid out in two columns instead of five lines down
; the foot of a phone.
;
; A credit laid out off the bottom of the picture is not a credit —
; tests/integration/test_main_menu.gd measures that rather than trusting the
; offsets here.
;
; Bottom-left and quiet on purpose. It is not a design element and it is not a
; secret: the licence asks for the title, the author and the licence, "reasonable
; to the medium", and a line of small type along the foot of the menu is what
; that looks like on a screen whose whole job is two buttons. main_menu.gd gives
; it Brand.MUTED over an ink outline, the same treatment the score wears, because
; the thing behind it is a lit driveway and grey on white is the one way muted
; type fails.
;
; anchors_preset 12 is bottom-wide: pinned to the bottom edge and stretched
; across, so the line sits on the floor of any screen shape rather than at a
; design-pixel offset a portrait phone would put in the middle of nowhere.
[node name="Credits" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -80.0
offset_right = -16.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 0
theme_override_font_sizes/font_size = 16
text = "Car models: “Generic passenger car pack” by Comrade1280 (skfb.ly/6sUFy) — CC BY 4.0\nSpray bottle: “Kitchen Spray” by Jesus Osco (sketchfab.com/gsus.vfx) — CC BY 4.0\nPressure washer: “homemade flamethrower” by excellenthe (sketchfab.com/excellenthe) — CC BY 4.0\nDriveway: “Sunken Driveway Parking Spot” by jimbogies (sketchfab.com/jimbogies) — CC BY 4.0"
autowrap_mode = 3

