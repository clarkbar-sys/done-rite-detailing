[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://src/screens/title_screen.gd" id="1_title"]
[ext_resource type="PackedScene" path="res://src/world/garage.tscn" id="2_garage"]
[ext_resource type="Texture2D" path="res://assets/brand/done-rite-logo.png" id="3_logo"]

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="Garage" parent="." instance=ExtResource("2_garage")]
orbiting = false
first_person = true
walkaround = true
attracting = true

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="LogoCard" type="PanelContainer" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4

[node name="Logo" type="TextureRect" parent="Center/Column/LogoCard"]
unique_name_in_owner = true
texture_filter = 4
custom_minimum_size = Vector2(380, 319)
layout_mode = 2
texture = ExtResource("3_logo")
expand_mode = 1
stretch_mode = 5

[node name="Gap" type="Control" parent="Center/Column"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2

; Start and Call side by side rather than stacked, and the reason is the height
; budget rather than a preference. The design is 720 px tall; the framed logo is
; 343 of them and a tap target is 164 at the very least (see TouchTarget), so a
; second button under Start puts this column past the bottom of the screen — and
; a CenterContainer answers that by overflowing both ends, which would take the
; top off the logo as well. Side by side is also what the site does with its own
; pair of buttons, and what the mockups in issue #75 do with theirs.
[node name="Buttons" type="HBoxContainer" parent="Center/Column"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 16

[node name="Start" type="Button" parent="Center/Column/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(440, 176)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 64
text = "Start"

; The number is written in by the script, not here: it is the business's, it
; already lives in Service, and a second copy in a scene file is one no test
; reads and no grep finds. Smaller type than Start on purpose — this is the
; button you press instead, not the one you press first.
[node name="Call" type="Button" parent="Center/Column/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(440, 176)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 40
text = "Call"

[node name="Build" type="Label" parent="."]
unique_name_in_owner = true
modulate = Color(1, 0, 0, 1)
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -320.0
offset_top = 16.0
offset_right = -16.0
grow_horizontal = 0
theme_override_font_sizes/font_size = 24
text = "v0.0.0 (local)"
horizontal_alignment = 2
