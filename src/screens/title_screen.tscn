[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://src/screens/title_screen.gd" id="1_title"]
[ext_resource type="PackedScene" path="res://src/world/garage.tscn" id="2_garage"]
[ext_resource type="Texture2D" path="res://assets/brand/done-rite-logo.png" id="3_logo"]
[ext_resource type="Script" path="res://src/ui/sound_toggle.gd" id="4_sound"]

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="Garage" parent="." instance=ExtResource("2_garage")]
orbiting = false
first_person = true
walkaround = true
attracting = true

; The one HUD control this screen has, in the corner none of its layout
; reaches — see src/ui/sound_toggle.gd. Positioned by the script itself, the
; same way GrimeDebug and ToolBeltHud place their own corners.
[node name="Sound" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 0
script = ExtResource("4_sound")

; `mouse_filter = 2` (ignore) rather than the engine's default `stop`: this is
; full-rect, so left at the default it would claim every point on the screen
; for itself — including the sound toggle's corner, where none of its own
; children are actually drawn — before a sibling earlier in the tree ever saw
; the press. Start itself is unaffected either way: a child control's own
; filter, not its container's, decides whether it reacts to a point over it.
[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Column" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="LogoCard" type="PanelContainer" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4

[node name="Logo" type="TextureRect" parent="Center/Column/LogoCard"]
unique_name_in_owner = true
texture_filter = 4
custom_minimum_size = Vector2(380, 319)
layout_mode = 2
texture = ExtResource("3_logo")
expand_mode = 1
stretch_mode = 5

[node name="Gap" type="Control" parent="Center/Column"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2

[node name="Start" type="Button" parent="Center/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(440, 176)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 64
text = "Start"

[node name="Build" type="Label" parent="."]
unique_name_in_owner = true
modulate = Color(1, 0, 0, 1)
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -320.0
offset_top = 16.0
offset_right = -16.0
grow_horizontal = 0
theme_override_font_sizes/font_size = 24
text = "v0.0.0 (local)"
horizontal_alignment = 2
