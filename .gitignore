# ── OS / editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.code-workspace

# ── Logs & temp ───────────────────────────────────────────────
*.log
tmp/
.cache/

# ── Secrets & local env (never commit these) ─────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Python (gdformat / gdlint) ─────────────────────────────────
# Pinned by requirements-dev.txt, fetched on demand — see the Makefile's
# .venv-lint recipe. Same treatment as .godot-sdk below: reproducible,
# gitignored, never installed system-wide.
.venv-lint/
__pycache__/

# ── Godot ─────────────────────────────────────────────────────
# Import cache, UID cache and editor layout — all regenerated by
# `godot --headless --import`. The *.import sidecars next to assets ARE
# committed; without them every checkout re-imports from scratch.
.godot/
# Pinned editor + export templates, downloaded by scripts/fetch-godot.sh.
.godot-sdk/
# Exported games and the export-time provenance stamp.
build/
build_stamp.json
# Godot 3 leftovers.
.import/
